digraph G {
rankdir=LR;
graph [fontname="monospace",bgcolor="white"];
node [fontname="monospace",fontsize=9];
edge [fontname="monospace",fontsize=7,color="#666666"];
label="canvas: phi"; labelloc=t; fontsize=14;
n0 [label="0: inlet", shape=box, style=filled, fillcolor="#e2e3e5"];
n1 [label="1: outlet", shape=box, style=filled, fillcolor="#e2e3e5"];
n2 [label="2: expr ($f1 / order_\\$0) * half_pi_\\$0", shape=box, style=filled, fillcolor="#e2e3e5"];
n3 [label="3: trigger bang float", shape=box, style=filled, fillcolor="#e2e3e5"];
n4 [label="4: v phi", shape=box, style=filled, fillcolor="#e2e3e5"];
n5 [label="5: expr even_\\$0 \\; order_\\$0", shape=box, style=filled, fillcolor="#e2e3e5"];
n6 [label="6: pack float float", shape=box, style=filled, fillcolor="#e2e3e5"];
n7 [label="7: loop -step 2", shape=box, style=filled, fillcolor="#e2e3e5"];
n0 -> n5 [label="0->0"];
n2 -> n3 [label="0->0"];
n3 -> n1 [label="0->0"];
n3 -> n4 [label="1->0"];
n5 -> n6 [label="0->0"];
n5 -> n6 [label="1->1"];
n6 -> n7 [label="0->0"];
n7 -> n2 [label="0->0"];
}