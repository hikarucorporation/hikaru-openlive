digraph G {
rankdir=LR;
graph [fontname="monospace",bgcolor="white"];
node [fontname="monospace",fontsize=9];
edge [fontname="monospace",fontsize=7,color="#666666"];
label="canvas: init"; labelloc=t; fontsize=14;
n0 [label="0: list split 1", shape=box, style=filled, fillcolor="#e2e3e5"];
n1 [label="1: route float", shape=box, style=filled, fillcolor="#e2e3e5"];
n2 [label="2: list", shape=box, style=filled, fillcolor="#e2e3e5"];
n3 [label="3: outlet", shape=box, style=filled, fillcolor="#e2e3e5"];
n4 [label="4: outlet", shape=box, style=filled, fillcolor="#e2e3e5"];
n5 [label="5: loadbang", shape=box, style=filled, fillcolor="#e2e3e5"];
n6 [label="6: args", shape=box, style=filled, fillcolor="#e2e3e5"];
n0 -> n1 [label="0->0"];
n0 -> n2 [label="1->1"];
n0 -> n3 [label="1->0"];
n1 -> n4 [label="0->0"];
n1 -> n2 [label="1->0"];
n2 -> n3 [label="0->0"];
n5 -> n6 [label="0->0"];
n6 -> n0 [label="0->0"];
}